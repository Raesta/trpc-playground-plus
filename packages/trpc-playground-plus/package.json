{
  "name": "trpc-playground-plus",
  "version": "1.0.0",
  "description": "Universal tRPC playground for any server (Fastify, Express, etc.)",
  "type": "module",
  "exports": {
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/fastify.es.js",
      "require": "./dist/fastify.cjs"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/express.es.js",
      "require": "./dist/express.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raesta/trpc-playground-plus.git"
  },
  "author": "Rémy Mulet <contact@underflow-studio.com>",
  "license": "MIT",
  "keywords": [
    "trpc",
    "playground",
    "api"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:lib": "vite build --config vite.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "build": "pnpm run build:lib && pnpm run build:app",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "release": "commit-and-tag-version --skip.tag",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:patch": "commit-and-tag-version --release-as patch --skip.tag",
    "release:minor": "commit-and-tag-version --release-as minor --skip.tag",
    "release:major": "commit-and-tag-version --release-as major --skip.tag",
    "release:beta": "commit-and-tag-version --prerelease beta --skip.tag",
    "release:alpha": "commit-and-tag-version --prerelease alpha --skip.tag",
    "release:rc": "commit-and-tag-version --prerelease rc --skip.tag",
    "tag": "git tag v$npm_package_version",
    "publish:beta": "pnpm run tag && git push --follow-tags && npm publish --tag beta",
    "publish:latest": "pnpm run tag && git push --follow-tags && npm publish"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@trpc/client": "^11.8.0",
    "@trpc/server": "^11.8.0",
    "@uiw/codemirror-theme-vscode": "^4.25.1",
    "@uiw/react-codemirror": "^4.25.1",
    "js-beautify": "^2.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "superjson": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.2",
    "@types/express": "^5.0.3",
    "@types/js-beautify": "^1.14.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "commit-and-tag-version": "^12.7.1",
    "express": "^5.1.0",
    "fastify": "^5.8.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/static": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  }
}
